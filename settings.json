{
  "env": {
    "BU_CDP": "http://localhost:9222"
  },
  "permissions": {
    "allow": [
      "Bash(gws:*)",
      "Bash(node scripts/detect-capabilities.js*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.ppk)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/credentials)",
      "Read(**/.credentials.json)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.pgpass)",
      "Read(**/.netrc)",
      "Read(**/.kube/config)",
      "Read(**/.docker/config.json)",
      "Read(**/*.kdbx)",
      "Read(**/gcloud/**)",
      "Read(**/Cookies)",
      "Read(**/Login Data)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(strings .env*)",
      "Bash(cat *.pem)",
      "Bash(head *.pem)",
      "Bash(tail *.pem)",
      "Bash(less *.pem)",
      "Bash(strings *.pem)",
      "Bash(cat *id_rsa*)",
      "Bash(head *id_rsa*)",
      "Bash(tail *id_rsa*)",
      "Bash(less *id_rsa*)",
      "Bash(strings *id_rsa*)",
      "Bash(cat */.ssh/*)",
      "Bash(head */.ssh/*)",
      "Bash(tail */.ssh/*)",
      "Bash(less */.ssh/*)",
      "Bash(strings */.ssh/*)",
      "Bash(cat */.aws/*)",
      "Bash(head */.aws/*)",
      "Bash(tail */.aws/*)",
      "Bash(less */.aws/*)",
      "Bash(strings */.aws/*)",
      "Bash(cat */.git-credentials)",
      "Bash(head */.git-credentials)",
      "Bash(tail */.git-credentials)",
      "Bash(less */.git-credentials)",
      "Bash(strings */.git-credentials)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(require('os').homedir(), '.claude', 'scripts', 'run-claude-entry.js')).main(process.argv.slice(1))\" -- hooks/session-handoff.js"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(require('os').homedir(), '.claude', 'scripts', 'run-claude-entry.js')).main(process.argv.slice(1))\" -- hooks/save-reminder.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(require('os').homedir(), '.claude', 'scripts', 'run-claude-entry.js')).main(process.argv.slice(1))\" -- hooks/on-git-push.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"require(require('path').join(require('os').homedir(), '.claude', 'scripts', 'run-claude-entry.js')).main(process.argv.slice(1))\" -- statusline.js"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "cache-band@local-mods": true
  },
  "extraKnownMarketplaces": {
    "local-mods": {
      "source": {
        "source": "directory",
        "path": "~/.claude/mods"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "agentPushNotifEnabled": false
}
