      }
    },
    {
      "name": "docker",
      "required": false,
      "why": "containerised workflows in 1 skill",
      "install": {
        "darwin": "brew install --cask docker",
        "win32": "winget install Docker.DockerDesktop",
        "default": "install Docker"
      }
    },
    {
      "name": "bw",
      "required": false,
      "why": "Bitwarden CLI \u2014 secrets backend for resolve-secret.js",
      "install": {
        "darwin": "brew install bitwarden-cli",
        "win32": "winget install Bitwarden.CLI",
        "default": "npm i -g @bitwarden/cli"
      }
    },
    {
      "name": "yt-dlp",
      "required": false,
      "why": "youtube skill search; video-edit downloads",
      "install": {
        "darwin": "brew install yt-dlp",
        "win32": "winget install yt-dlp.yt-dlp",
        "default": "uv tool install yt-dlp"
      }
    },
    {
      "name": "auto-editor",
      "required": false,
      "why": "video-edit skill silence/jump-cut pass",
      "install": {
        "darwin": "uv tool install auto-editor",
        "win32": "uv tool install auto-editor",
        "default": "uv tool install auto-editor"
      }
    },
    {
      "name": "pre-commit",
      "required": false,
      "why": "pre-commit-wiring skill",
      "install": {
        "darwin": "uv tool install pre-commit",
        "win32": "uv tool install pre-commit",
        "default": "uv tool install pre-commit"
      }
    },
    {
      "name": "gitleaks",
      "required": false,
      "why": "pre-commit-wiring secret scanning",
      "install": {
        "darwin": "brew install gitleaks",
        "win32": "winget install Gitleaks.Gitleaks",
        "default": "install gitleaks"
      }
    },
    {
      "name": "playwright",
      "required": false,
      "why": "animate skill renderer (needs Chromium: npx playwright install chromium)",
      "install": {
